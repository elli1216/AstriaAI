# ─────────────────────────────────────────────────────────────────────────────
# frontend/convex/.env
#
# These variables are read by Convex functions at runtime (server-side only).
# They are NEVER sent to the browser.
#
# Set them in the Convex dashboard:
#   Dashboard → Settings → Environment Variables
# Or via CLI:
#   npx convex env set VARIABLE_NAME value
#
# Copy this file as a reference — do NOT commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL: https://<your-deployment>.convex.site/api/auth/callback/github
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── GitHub App (for webhook & repo access) ────────────────────────────────────
# Create a GitHub App at: https://github.com/settings/apps/new
# Required permissions: Pull requests (read), Contents (read), Webhooks (write)
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your_random_webhook_secret_here

# ── FastAPI Backend ───────────────────────────────────────────────────────────
# URL of your running FastAPI backend (http://localhost:8000 for local dev)
BACKEND_URL=http://localhost:8000

# ── Convex Auth ───────────────────────────────────────────────────────────────
# The public URL of your Convex deployment (same value as VITE_CONVEX_URL,
# but available server-side for auth redirect validation)
CONVEX_SITE_URL=https://your-deployment-name.convex.site
