# ─────────────────────────────────────────────────────────────────────────────
# frontend/.env.local
#
# VITE_ prefixed vars are bundled into the browser at build time.
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Your Convex deployment URL.
# Generated automatically when you run `npx convex dev` — copy it from the
# Convex dashboard (Settings → URL & Deploy Key) or the terminal output.
# Format: https://<your-deployment-name>.convex.cloud
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud
